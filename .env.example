# Runtime
NODE_ENV=production
PORT=8080

# Site público
NEXT_PUBLIC_SITE_NAME=Marques Papelaria
# Origem canônica HTTPS. Em produção, também é a autoridade do boundary CSRF; não use path/query/fragmento.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br
NEXT_PUBLIC_LOCATION=Santa Inês - MA
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=5598999999999
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_PINTEREST_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Neon PostgreSQL
DATABASE_URL=

# Admin — gere SESSION_SECRET com: openssl rand -base64 48
SESSION_SECRET=
# Segredo estável para tombstones de privacidade/LGPD. Não rotacione sem plano de migração.
PRIVACY_HASH_SECRET=
# Assinatura HMAC-SHA256 de backups. Obrigatório em produção a partir da V6.31.
BACKUP_SIGNING_SECRET=
# Opcional durante rotação: mantenha temporariamente a chave anterior para validar backups antigos assinados.
BACKUP_SIGNING_PREVIOUS_SECRET=
# Rótulo não secreto gravado no manifesto, ex.: 2026-q3.
BACKUP_SIGNING_KEY_ID=primary
# Criptografia AES-256-GCM dos backups. Obrigatório em produção a partir da V6.32.
BACKUP_ENCRYPTION_SECRET=
# Opcional durante rotação da chave de criptografia.
BACKUP_ENCRYPTION_PREVIOUS_SECRET=
# Rótulo não secreto gravado no envelope criptografado.
BACKUP_ENCRYPTION_KEY_ID=primary
# Prefira ADMIN_PASSWORD_HASH. Gere com: npm run admin:hash-password -- "sua-senha-forte"
ADMIN_PASSWORD_HASH=
# Compatibilidade temporária. Em produção, prefira deixar vazio quando usar ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=

# MFA/TOTP administrativo — obrigatório em produção. Gere com: npm run admin:generate-mfa
# Adicione o segredo manualmente no Google Authenticator, Authy, 1Password ou app TOTP compatível.
ADMIN_TOTP_SECRET=


# Alertas externos de segurança (opcional)
# Endpoint HTTPS que receberá JSON em eventos importantes do Admin.
ADMIN_SECURITY_WEBHOOK_URL=
# Se o webhook estiver configurado em produção, use um segredo forte (>=32 chars).
# O payload recebe x-marques-signature: sha256=<HMAC>.
ADMIN_SECURITY_WEBHOOK_SECRET=
# Opcional: eventos/severidades separados por vírgula. Ex.: warning,critical,new_device_login
# Vazio = envia warning e critical.
ADMIN_SECURITY_WEBHOOK_EVENTS=

# Storage S3 compatível (opcional)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=


# Backup offsite automático V6.34 (bucket privado separado do storage público de mídia)
# Ative no GitHub com Repository Variable BACKUP_OFFSITE_ENABLED=1.
BACKUP_OFFSITE_ENABLED=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Raiz do cofre: banco usa <prefix>/database/ e mídia usa <prefix>/media/.
BACKUP_S3_PREFIX=marques-backups
# 7 a 3650 dias; padrão recomendado: 45.
BACKUP_OFFSITE_RETENTION_DAYS=45
# Freshness operacional: atraso máximo permitido antes de alertar (24–720 h; padrão 36).
BACKUP_OFFSITE_MAX_AGE_HOURS=36
# Uso interno/CLI; normalmente deixe vazio. O job offsite aponta para diretório temporário.
BACKUP_OUTPUT_DIR=
# 1 para provedores S3 compatíveis que exigem path-style; 0 para virtual-host style.
BACKUP_S3_FORCE_PATH_STYLE=1

# Testes funcionais locais/CI (opcional; não configure em produção)
E2E_BASE_URL=
E2E_ADMIN_PASSWORD=
E2E_ADMIN_TOTP_SECRET=
# Somente GitHub Actions; nunca configure no deploy real.
MARQUES_CI_STATELESS_AUTH=

# Identidade do release / deploy (recomendado em produção)
# Use um identificador imutável por publicação, ex.: 2026-09-09.1 ou SHA curto do commit.
APP_RELEASE_ID=
APP_RELEASE_COMMIT=
# ISO-8601, ex.: 2026-09-09T02:30:00Z
APP_DEPLOYED_AT=

# Se o catálogo depender do S3 para operar, use 1. Com 0/vazio, falha do S3 degrada o deep health,
# mas não tira a readiness do catálogo público.
S3_REQUIRED=

# Ferramentas de verificação pós-deploy/rollback (somente CLI/CI; opcionais)
DEPLOY_BASE_URL=
EXPECTED_RELEASE_ID=
PREVIOUS_RELEASE_ID=
DEPLOY_REQUIRE_STORAGE=

# Smoke de carga pós-deploy (opcional; normalmente fornecido por argumento)
LOAD_BASE_URL=

# Deploy gate opcional: exija backup offsite recente antes de promover uma release.
DEPLOY_REQUIRE_BACKUP_FRESH=

# V6.36 — ensaio de recuperação. Use um Neon separado do banco operacional.
DRILL_DATABASE_URL=
RECOVERY_DRILL_ENABLED=
RECOVERY_DRILL_MAX_AGE_HOURS=192
RECOVERY_DRILL_CONFIRM_ISOLATED=
DEPLOY_REQUIRE_RECOVERY_DRILL_FRESH=

# V6.37 — espelho privado dos arquivos de mídia do catálogo.
MEDIA_BACKUP_ENABLED=
MEDIA_BACKUP_MAX_AGE_HOURS=36

# V6.39 — ensaio semanal de recuperação de mídia em bucket isolado.
MEDIA_RECOVERY_DRILL_ENABLED=
MEDIA_RECOVERY_DRILL_MAX_AGE_HOURS=192
MEDIA_RECOVERY_DRILL_CONFIRM_ISOLATED=
DRILL_S3_ENDPOINT=
DRILL_S3_REGION=auto
DRILL_S3_BUCKET=
DRILL_S3_ACCESS_KEY_ID=
DRILL_S3_SECRET_ACCESS_KEY=
DRILL_S3_FORCE_PATH_STYLE=1
DEPLOY_REQUIRE_MEDIA_RECOVERY_DRILL_FRESH=
